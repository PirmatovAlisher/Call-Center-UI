@page "/call-history"


@inherits Microsoft.AspNetCore.Components.ComponentBase
@inject DialogService DialogService
@inject NotificationService NotificationService
@inject ContextMenuService ContextMenuService
@inject IDataExportService ExportService
@using ClosedXML.Excel
@using System.Data

@inject IJSRuntime JSRuntime



<RadzenCard Variant="Variant.Filled" Style="height: 850px">

	<div class="rz-display-flex justify-content-between px-1">
		<RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Start">
			<RadzenText TextStyle="Radzen.Blazor.TextStyle.H4">Company Call History</RadzenText>
		</RadzenStack>
		<RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">
			<RadzenSplitButton Text="Download" Click="@(args => DownloadOptions(args))" Disabled="isExporting" Icon="download" Size="ButtonSize.Medium"
							   class="no-uppercase rz-border-radius-4" AlwaysOpenPopup=true ButtonStyle="ButtonStyle.Primary" DropDownIcon="more_vert" Variant="Variant.Outlined">
				<ChildContent>
					<RadzenSplitButtonItem Text="PDF (Portrait)" Value="1" />
					<RadzenSplitButtonItem Text="PDF (Landscape)" Value="2" />
					<RadzenSplitButtonItem Text="XLSX..." Value="3" />
					<RadzenSplitButtonItem Text="CSV (Formatted)" Value="4" />
					<RadzenSplitButtonItem Text="Voicemails will not be" Value="5" Disabled="true" />
					<RadzenSplitButtonItem Text="included in exports." Value="6" Disabled="true" />
				</ChildContent>
			</RadzenSplitButton>
		</RadzenStack>
	</div>
	<RadzenText TextStyle="Radzen.Blazor.TextStyle.Subtitle2" class="rz-mb-3">240 Calls Today | 84% Company Close Rate</RadzenText>

	<RadzenRow JustifyContent="JustifyContent.SpaceBetween" class="rz-mb-3">
		<!-- Filter Presets -->
		<RadzenStack Orientation="Orientation.Horizontal" Gap="15px" class="rz-mb-3">
			<RadzenButton Text="All"
						  Click="@(() => { activeFilter = null ; ApplyFilters(); })"
						  Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Medium"
						  class="@(activeFilter == null ? "rz-background-color-info-lighter rz-border-radius-6 no-uppercase" : "rz-border-radius-6 no-uppercase")" />

			<RadzenButton Text="New"
						  Click="@(() => { activeFilter = CustomerType.New ; ApplyFilters(); })"
						  Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Medium"
						  class="@(activeFilter == CustomerType.New ? "rz-background-color-info-lighter rz-border-radius-6 no-uppercase" : "rz-border-radius-6 no-uppercase")" />

			<RadzenButton Text="Lead"
						  Click="@(() => { activeFilter = CustomerType.Lead ; ApplyFilters(); })"
						  Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Medium"
						  class="@(activeFilter == CustomerType.Lead ? "rz-background-color-info-lighter rz-border-radius-6 no-uppercase" : "rz-border-radius-6 no-uppercase")" />

			<RadzenButton Text="Prospect"
						  Click="@(() => { activeFilter = CustomerType.Prospect ; ApplyFilters(); })"
						  Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Medium"
						  class="@(activeFilter == CustomerType.Prospect ? "rz-background-color-info-lighter rz-border-radius-6 no-uppercase" : "rz-border-radius-6 no-uppercase")" />
			<RadzenButton Text="VIP"
						  Click="@(() => { activeFilter = CustomerType.VIP ; ApplyFilters(); })"
						  Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Medium"
						  class="@(activeFilter == CustomerType.VIP ? "rz-background-color-info-lighter rz-border-radius-6 no-uppercase" : "rz-border-radius-6 no-uppercase")" />
		</RadzenStack>

		<RadzenStack Orientation="Orientation.Horizontal" Gap="15px" AlignItems="AlignItems.Center">
			@if (selectedCalls.Any())
			{
				<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center"
							 class="rz-background-color-success-lighter rz-border-radius-6" Style="width: 200px; height: 40px;">
					<div class="rz-text-secondary">
						Selected @selectedCalls.Count() of @FilteredCalls.Count() calls
					</div>
				</RadzenStack>
			}
			<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center"
						 class="rz-background-color-warning-lighter rz-border-radius-6" Style="width: 200px; height: 40px;">
				<div class="rz-text-secondary">
					Showing @FilteredCalls.Count() of @SeedDataProvider.Calls.Count calls
				</div>
			</RadzenStack>

			<!-- Search Box -->
			<RadzenTextBox @bind-Value="@searchTerm"
						   Placeholder="Search..."
						   Style="min-width: 250px;"
						   Change="@(() => OnSearch())" />
		</RadzenStack>
	</RadzenRow>


	<RadzenDataGrid @ref="grid" TItem="Call" Data="FilteredCalls" IsLoading="@isLoading" @bind-Value=@selectedCalls
					AllowRowSelectOnRowClick="true" SelectionMode="DataGridSelectionMode.Multiple"
					AllowSorting="true" AllowPaging="true" PagerHorizontalAlign="HorizontalAlign.Center" PageSize="9">
		
		<Columns>

			<!-- Selection Check box -->
			<RadzenDataGridColumn TItem="Call" Sortable="false" Filterable="false" Width="25px">
				<HeaderTemplate>
					<RadzenCheckBox TValue="bool"
									Value="@IsAllSelected"
									Change="@(async _ => await ToggleSelectAll())" />
				</HeaderTemplate>
				<Template Context="call">
					<RadzenCheckBox TValue="bool"
									Value="@(selectedCalls.Contains(call))"
									Change="@(_ => ToggleSelection(call))" />
				</Template>
			</RadzenDataGridColumn>

			<!-- Call Type -->
			<RadzenDataGridColumn Property="@nameof(Call.CallType)" TItem="Call" Title="Call Type" Width="35px">
				<Template Context="call">
					@switch (call.CallType)
					{
						case CallType.Inbound:
							<RadzenIcon IconStyle="IconStyle.Success" Icon="call_received" />
							break;
						case CallType.Outbound:
							<RadzenIcon IconStyle="IconStyle.Warning" Icon="call_made" />
							break;
						case CallType.Missed:
							<RadzenIcon IconStyle="IconStyle.Danger" Icon="call_missed" />
							break;
						case CallType.Rejected:
							<RadzenIcon IconStyle="IconStyle.Info" Icon="block" />
							break;

						default:
							<RadzenIcon IconStyle="IconStyle.Base" Icon="remove" />
							break;
					}
				</Template>
			</RadzenDataGridColumn>

			<!-- Agent Column -->
			<RadzenDataGridColumn Property="@nameof(Call.Agent.Id)" TItem="Call" Title="Agent" Width="70px">
				<Template Context="call">
					@if (call.Agent != null)
					{
						<span class="rz-text-secondary">
							@HighlightMatch(call.Agent.Extension)
						</span>
						<br />
						<span class="rz-text-primary text-sm">
							Agent: @HighlightMatch(call.Agent.FirstName) @HighlightMatch(call.Agent.LastName)
						</span>
					}
				</Template>
			</RadzenDataGridColumn>

			<!-- Account -->
			<RadzenDataGridColumn Property="@nameof(Call.CallerNumber)" TItem="Call" Title="Account" Width="70px">
				<Template Context="call">
					<span class="rz-text-secondary">
						<a href="#">@HighlightMatch(call.CallerNumber)</a>
					</span>
					<br />
					@if (call.Customer != null)
					{
						<span class="rz-text-primary text-sm">
							Name: @HighlightMatch(call.Customer!.FirstName) @HighlightMatch(call.Customer.LastName)
						</span>
					}
					else
					{
						<span class="rz-text-primary text-sm">
							Name: Unknown
						</span>
					}
				</Template>
			</RadzenDataGridColumn>

			<!-- Time Column -->
			<RadzenDataGridColumn Property="@nameof(Call.StartTime)" TItem="Call" Title="Time (EST)" Width="75px">
				<Template Context="call">
					@call.StartTime.ToString("ddd MMM d, yyyy-H:mm:ss")
				</Template>
			</RadzenDataGridColumn>

			<!-- Customer Type Column -->
			<RadzenDataGridColumn Property="@nameof(Call.Customer)" TItem="Call" Title="Account Status" Width="55px">
				<Template Context="call">
					@if (call.Customer != null)
					{
						switch (call.Customer.Type)
						{
							case CustomerType.VIP:
								<RadzenBadge Text="@call.Customer.Type.ToString()" BadgeStyle="BadgeStyle.Primary" Shade="Shade.Lighter" class="no-uppercase" />
								break;
							case CustomerType.New:
								<RadzenBadge Text="@call.Customer.Type.ToString()" BadgeStyle="BadgeStyle.Success" Shade="Shade.Lighter" class="no-uppercase" />
								break;
							case CustomerType.Prospect:
								<RadzenBadge Text="@call.Customer.Type.ToString()" BadgeStyle="BadgeStyle.Light" Shade="Shade.Lighter" class="no-uppercase" />
								break;
							case CustomerType.Lead:
								<RadzenBadge Text="@call.Customer.Type.ToString()" BadgeStyle="BadgeStyle.Warning" Shade="Shade.Lighter" class="no-uppercase" />
								break;
							case CustomerType.Existing:
								<RadzenBadge Text="@call.Customer.Type.ToString()" BadgeStyle="BadgeStyle.Info" Shade="Shade.Lighter" class="no-uppercase" />
								break;
							default:
								<RadzenBadge Text="No Information" BadgeStyle="BadgeStyle.Secondary" Shade="Shade.Lighter" class="no-uppercase" />
								break;
						}
					}
					else
					{
						<RadzenBadge Text="No Information" BadgeStyle="BadgeStyle.Secondary" Shade="Shade.Lighter" class="no-uppercase" />
					}
				</Template>
			</RadzenDataGridColumn>

			<!-- Customer Account Number Column -->
			<RadzenDataGridColumn Property="@nameof(Call.Customer.AccountNumber)" TItem="Call" Title="Account Number" Width="60px">
				<Template Context="call">
					@if (call.Customer != null)
					{
						@HighlightMatch(call.Customer.AccountNumber)
					}
					else
					{
						<p>-</p>
					}
				</Template>
			</RadzenDataGridColumn>

			<!-- Waiting Time -->
			<RadzenDataGridColumn Property="@nameof(Call.WaitTime)" TItem="Call" Title="Waiting Time" Width="60px">
				<Template Context="call">
					@call.WaitTime.ToString()
				</Template>
			</RadzenDataGridColumn>

			<!-- Talking Time -->
			<RadzenDataGridColumn Property="@nameof(Call.TalkTime)" TItem="Call" Title="Talk Time" Width="60px">
				<Template Context="call">
					@call.TalkTime.ToString()
				</Template>
			</RadzenDataGridColumn>

			<!-- Call Recording Column -->
			<RadzenDataGridColumn Property="@nameof(Call.IsRecorded)" TItem="Call" Title="Recording" Width="50px">
				<Template Context="call">
					@if (!string.IsNullOrEmpty(call.RecordingUrl))
					{
						<div class="flex items-center gap-2">
							<RadzenButton Icon="play_circle"
										  Click="@(args => PlayRecording(call))"
										  Variant="Variant.Text" />
							<span class="text-sm">
								@(call.TalkTime.ToString(@"mm\:ss"))
							</span>
						</div>
					}
					else
					{
						<span class="rz-text-secondary">No recording</span>
					}
				</Template>
			</RadzenDataGridColumn>

			<!-- Actions Column -->
			<RadzenDataGridColumn TItem="Call" Title="Actions" Width="50px">
				<Template Context="call">
					<RadzenSplitButton Text="more" Click="@(args => ShowActions(args, call))"
									   class="no-uppercase" AlwaysOpenPopup=true ButtonStyle="ButtonStyle.Base" DropDownIcon="more_vert" Variant="Variant.Text">
						<ChildContent>
							<RadzenSplitButtonItem Text="View Details" Value="1" Icon="visibility" IconColor="#14A44D"
												   onmouseover="this.style.backgroundColor='#14A44D'; this.style.color='white';"
												   onmouseout="this.style.backgroundColor='white'; this.style.color='black';" />
							<RadzenSplitButtonItem Text="Edit" Value="2" Icon="edit" IconColor="#E4A11B"
												   onmouseover="this.style.backgroundColor='#E4A11B'; this.style.color='white';"
												   onmouseout="this.style.backgroundColor='white'; this.style.color='black';" />
							<RadzenSplitButtonItem Text="Delete" Value="3" Icon="delete" IconColor="#DC4C64"
												   onmouseover="this.style.backgroundColor='#DC4C64'; this.style.color='white';"
												   onmouseout="this.style.backgroundColor='white'; this.style.color='black';" />
						</ChildContent>
					</RadzenSplitButton>

				</Template>
			</RadzenDataGridColumn>

		</Columns>
	</RadzenDataGrid>

</RadzenCard>


@* Table and Actions *@
@code {

	RadzenDataGrid<Call> grid;


	IEnumerable<Call> FilteredCalls = new List<Call>();

	protected override async Task OnInitializedAsync()
	{
		isLoading = true; // Show loading
		StateHasChanged();
		// Simulate async operation (replace with real data fetching)
		await Task.Delay(1000);

		FilteredCalls = SeedDataProvider.Calls;

		isLoading = false; // Hide loading
		StateHasChanged();
	}


	private async Task ShowActions(RadzenSplitButtonItem item, Call call)
	{
		if (item != null)
		{
			switch (item.Value)
			{
				case "1":
					await ViewDetails(call);
					break;
				case "2":
					await EditCall(call);
					break;
				case "3":
