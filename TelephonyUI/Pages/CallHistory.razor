@* Filtering and Searching *@
@code {

	private CustomerType? activeFilter { get; set; } = null;
	private string searchTerm = "";

	private bool isLoading = false; // Controls loading visibility

	async Task OnSearch()
	{
		searchTerm = searchTerm?.Trim().ToLower()!;
		await ApplyFilters();
	}

	private async Task ApplyFilters()
	{
		isLoading = true; // Show loading
		StateHasChanged(); // Force UI update
									// Simulate async operation (replace with real data fetching)
		await Task.Delay(500);

		var query = SeedDataProvider.Calls.AsEnumerable();

		// Apply preset filter
		if (activeFilter.HasValue)
		{
			query = SeedDataProvider.Calls.Where(x => x.Customer != null && x.Customer?.Type == activeFilter);
		}

		// Apply search filter
		if (!string.IsNullOrEmpty(searchTerm))
		{
			query = query.Where(c =>
								(c.Agent?.FirstName?.ToLower().Contains(searchTerm)) == true ||
								(c.Agent?.LastName?.ToLower().Contains(searchTerm)) == true ||
								(c.Agent?.Extension?.Contains(searchTerm) == true) ||
								(c.Customer?.FirstName?.ToLower().Contains(searchTerm) == true) ||
								(c.Customer?.LastName?.ToLower().Contains(searchTerm) == true) ||
								(c.Customer?.PhoneNumber.Contains(searchTerm) == true) ||
								(c.Customer?.AccountNumber.ToLower().Contains(searchTerm) == true) ||
								(c.CallerNumber?.Contains(searchTerm) == true)
			);
		}

		FilteredCalls = query.ToList();
		isLoading = false; // Hide loading
		StateHasChanged();
		await grid.Reload();
	}

	MarkupString HighlightMatch(string text)
	{
		if (string.IsNullOrEmpty(searchTerm) || string.IsNullOrEmpty(text))
			return (MarkupString)text;

		return (MarkupString)text.Replace(searchTerm,
									$"<strong class=\"rz-background-color-warning-dark\">{searchTerm}</strong>",
									StringComparison.OrdinalIgnoreCase);
	}
}

@* Row Selection *@
@code {
	private IList<Call> selectedCalls = new List<Call>();
	private bool isExporting;

	private bool IsAllSelected =>
		FilteredCalls.Any() && selectedCalls.Count() == FilteredCalls.Count();

	private async Task ToggleSelectAll()
	{
		if (IsAllSelected)
		{
			selectedCalls = new List<Call>();
		}
		else
		{
			selectedCalls = new List<Call>(FilteredCalls);
		}
		await grid.Reload();
		StateHasChanged();
	}

	private void ToggleSelection(Call call)
	{
		if (selectedCalls.Contains(call))
		{
			selectedCalls.Remove(call);
		}
		else
		{
			selectedCalls.Add(call);
		}

		// Optional: Force grid refresh if needed
		StateHasChanged();
	}

	private async Task DownloadOptions(RadzenSplitButtonItem item)
	{
		if (item != null)
		{
			switch (item.Value)
			{
				case "1":
					await ExportCallsToPDF(false);
					break;
				case "2":
					await ExportCallsToPDF(true);
					break;
				case "3":
					await ExportCallsToExcel();
					break;
				case "4":
					await ExportCallsToCsv();
					break;
				default:
					await ExportCallsToExcel();
					break;
			}
		}
	}

}

@* File generations *@
@code
{
	private async Task ExportCallsToExcel()
	{
		try
		{
			isExporting = true; 
			NotificationService.Notify(new NotificationMessage
				{
					Severity = NotificationSeverity.Info,
					Summary = "Exporting...",
					Duration = 4000
				});

			var data = selectedCalls.Any() ? selectedCalls : SeedDataProvider.Calls;

			await ExportService.ExportToExcel(data);
		}
		catch (Exception ex)
		{
			NotificationService.Notify(NotificationSeverity.Error, "Export Failed", ex.Message, 5000);
		}
		finally
		{
			isExporting = false;
			StateHasChanged();
		}
	}

	private async Task ExportCallsToCsv()
	{
		try
		{
			isExporting = true;
			NotificationService.Notify(new NotificationMessage
				{
					Severity = NotificationSeverity.Info,
					Summary = "Exporting...",
					Duration = 4000
				});


			var data = selectedCalls.Any() ? selectedCalls : SeedDataProvider.Calls;

			await ExportService.ExportToFormattedCsv(data);
		}
		catch (Exception ex)
		{
			NotificationService.Notify(NotificationSeverity.Error, "Export Failed", ex.Message, 5000);
		}
		finally
		{
			isExporting = false;
			StateHasChanged();
		}
	}

	private async Task ExportCallsToPDF(bool isLandscape)
	{
		try
		{
			isExporting = true;
			NotificationService.Notify(new NotificationMessage
				{
					Severity = NotificationSeverity.Info,
					Summary = "Preparing PDF export...",
					Duration = 2000
				});

			var data = selectedCalls.Any() ? selectedCalls : SeedDataProvider.Calls;
			await ExportService.ExportToPDF(data, isLandscape);

		}
		catch (Exception ex)
		{
			NotificationService.Notify(new NotificationMessage
				{
					Severity = NotificationSeverity.Error,
					Summary = "PDF export failed",
					Detail = ex.Message,
					Duration = 5000
				});
		}
		finally
		{
			isExporting = false;
			StateHasChanged();
		}
	}
}