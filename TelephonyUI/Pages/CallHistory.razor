		</audio>
		<RadzenCard>
			<p>@recording.Transcription</p>
		</RadzenCard>
	</RadzenStack>
	,
	new DialogOptions() { Width = "500px", Height = "auto" });
		}
	}

	async Task ViewDetails(Call call)
	{
		//Implement view details logic
		await DialogService.OpenAsync<CallDetailsDialog>(
