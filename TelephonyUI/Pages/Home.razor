@page "/"
<PageTitle>Home</PageTitle>

<RadzenText TextStyle="TextStyle.DisplayH4"><stong>Channels</stong></RadzenText>
<RadzenText TextStyle="TextStyle.Body2"><strong>75% Closed Rate | 90% Persistency | 95% First-Payment</strong></RadzenText>

<RadzenTabs RenderMode="TabRenderMode.Client" @bind-SelectedIndex=@selectedIndex class="no-uppercase-tabs">
	<Tabs>
		<RadzenTabsItem Text="Call">
			<RadzenRow>
				<RadzenColumn Size="12" SizeLG="8" class="rz-p-5">
					<HomeCallHistoryComponent />
				</RadzenColumn>
				<RadzenColumn Size="12" SizeLG="4" class="rz-background-color-info-lighter rz-color-on-info-lighter rz-p-5 rz-shadow-6">
					<RadzenText TextStyle="TextStyle.DisplayH5"><stong>Accounts</stong></RadzenText>
					<P>
						This is the content for the smaller column. It will occupy 4/12ths of the row on medium and larger screens, and the full 12/12ths on small screens.
					</P>
				</RadzenColumn>
			</RadzenRow>
		</RadzenTabsItem>
		<RadzenTabsItem Text="SMS">
			<RadzenRow>
				<RadzenColumn Size="12" SizeLG="8" class="rz-p-5">
					<HomeSMSComponent Contacts="@Contacts" />
				</RadzenColumn>
				<RadzenColumn Size="12" SizeLG="4" class="rz-background-color-info-lighter rz-color-on-info-lighter rz-p-5 rz-shadow-6">
					<RadzenText TextStyle="TextStyle.DisplayH5"><stong>Accounts</stong></RadzenText>
					<P>
						This is the content for the smaller column. It will occupy 4/12ths of the row on medium and larger screens, and the full 12/12ths on small screens.
					</P>
				</RadzenColumn>
			</RadzenRow>
		</RadzenTabsItem>
		<RadzenTabsItem Text="Email">
			<RadzenRow>
				<RadzenColumn Size="12" SizeLG="8" class="rz-p-5">
					<HomeEmailComponent />
				</RadzenColumn>
				<RadzenColumn Size="12" SizeLG="4" class="rz-background-color-info-lighter rz-color-on-info-lighter rz-p-5 rz-shadow-6">
					<RadzenText TextStyle="TextStyle.DisplayH5"><stong>Accounts</stong></RadzenText>
					<P>
						This is the content for the smaller column. It will occupy 4/12ths of the row on medium and larger screens, and the full 12/12ths on small screens.
					</P>
				</RadzenColumn>
			</RadzenRow>
		</RadzenTabsItem>
	</Tabs>
</RadzenTabs>


