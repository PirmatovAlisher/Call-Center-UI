

@using TelephonyUI.Shared.Components._Accounts

@implements IDisposable
@inject IJSRuntime JSRuntime



@* <div class="desktop-version">
	<DesktopLayout Customers="@customers"
				   @bind-SelectedCustomer="selectedCustomer" />
</div>

<div class="mobile-version">
	<MobileLayout Customers="@customers"
				  @bind-SelectedCustomer="selectedCustomer" />
</div> *@

<div @ref="containerRef">
	@if (isWideContainer)
	{
		<DesktopLayout Customers="@customers" @bind-SelectedCustomer="selectedCustomer" />
	}
	else
	{
		<MobileLayout Customers="@customers" @bind-SelectedCustomer="selectedCustomer" />
	}
</div>



@code {
	private Customer? selectedCustomer;

	private List<Customer> customers = SeedDataProvider.Customers;


	private ElementReference containerRef;
	private DotNetObjectReference<AccountComponent>? objRef;
	private bool isWideContainer;
	private const int DesktopMinWidth = 768; // px


	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			objRef = DotNetObjectReference.Create(this);
			await JSRuntime.InvokeVoidAsync("registerContainerObserver", containerRef, objRef);
		}
	}

	[JSInvokable]
	public void UpdateContainerWidth(decimal width)
	{
		var newState = width >= DesktopMinWidth;
		if (newState != isWideContainer)
		{
			isWideContainer = newState;
			InvokeAsync(StateHasChanged);
		}
	}


	public void Dispose()
	{
		JSRuntime.InvokeVoidAsync("unregisterContainerObserver", containerRef);
		objRef?.Dispose();
	}

}

<style>
	.desktop-version {
		display: block;
	}

	.mobile-version {
		display: none;
	}

	/* @@media (max-width: 768px) { */
	@@media (max-width: 768px) {
		.desktop-version {
			display: none !important;
		}

		.mobile-version {
			display: block !important;
		}
	}
</style>