@if (Customer != null)
{
	<RadzenCard Variant="Variant.Text">

		<h3>@Customer.FirstName @Customer.LastName</h3>
		<div class="detail-item">
			<RadzenIcon Icon="email" /> @Customer.Email
		</div>
		<div class="detail-item">
			<RadzenIcon Icon="phone" /> @Customer.PhoneNumber
		</div>
		<div class="detail-item">
			<RadzenIcon Icon="account_balance" /> @Customer.AccountNumber
		</div>
	</RadzenCard>
}
else
{
	<RadzenCard Variant="Variant.Filled">
		<div class="no-selection">
			No customer selected
		</div>
	</RadzenCard>
}

@code {
	[Parameter]
	public Customer Customer { get; set; } = new();
}

<style>
	.customer-details-container {
		padding: 20px;
	}

	.detail-item {
		margin: 15px 0;
	}

		.detail-item label {
			display: inline-block;
			width: 120px;
			font-weight: 500;
			color: #666;
		}
</style>