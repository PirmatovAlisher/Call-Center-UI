
<div class="desktop-container">
	<div class="list-container rz-border-right">
		<CustomerList Customers="@Customers"
					  @bind-SelectedCustomer="SelectedCustomer" />
	</div>
	<div class="details-container">
		@if (SelectedCustomer != null)
		{
			<RadzenCard Style="height: 850px; padding: 0px;">
				<RadzenButton Icon="arrow_back" Text="Back"
							  Click="@(() => SelectedCustomer = null)"
							  Style="margin-bottom: 15px;" />
				<CustomerView Customer="@SelectedCustomer" />
			</RadzenCard>
		}
		else
		{
			<div class="empty-state">
				<RadzenIcon Icon="info" Style="font-size: 2rem; color: #666;" />
				<p>Select a customer to view details</p>
			</div>
		}
	</div>
</div>

@code
{
	[Parameter] public List<Customer> Customers { get; set; }
	[Parameter] public Customer SelectedCustomer { get; set; }
	[Parameter] public EventCallback<Customer> SelectedCustomerChanged { get; set; }
}

<style>
	.desktop-container {
		display: grid;
		grid-template-columns: 300px 1fr;
		gap: 20px;
		height: 100%;
	}
</style>

<style>
	.desktop-layout {
		display: flex;
		/* height: 100vh; */
		height: inherit;
	}

	.list-container {
		width: 300px;
		/* border-right: 1px solid #ddd; */
	}

	.empty-state {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		height: 100%;
		color: #666;
	}

	.details-container {
		flex: 1;
		/* padding: 20px; */
		padding: 0px;
		overflow-y: auto;
		/* Add these lines */
		display: block !important;
		visibility: visible !important;
		opacity: 1 !important;
		transition: opacity 0.3s ease;
	}
</style>