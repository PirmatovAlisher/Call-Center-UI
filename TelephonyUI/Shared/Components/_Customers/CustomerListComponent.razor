
<RadzenListBox TValue="Customer"
			   Data="@Customers"
			   Value="SelectedCustomer"
			   ValueChanged="@(async (Customer c) => await OnCustomerSelected.InvokeAsync(c))"
			   class="borderless-listbox"
			   Style="padding: 0; display: flex; flex-direction: column; overflow-y: auto;">

	<Template Context="customer">
		<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Normal" JustifyContent="JustifyContent.SpaceBetween" Gap="3px">
			<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center">
				<!-- Gravatar -->
				<RadzenGravatar Text="@customer.FirstName" Size="36" Style="margin-right: 15px;" />
				<RadzenStack Orientation="Orientation.Vertical">
					<div><strong>@customer.FirstName @customer.LastName</strong></div>
					<p>Last Contact: @customer.LastContactDate.ToShortDateString()</p>
				</RadzenStack>
			</RadzenStack>
			<RadzenStack Orientation="Orientation.Vertical">
				<RadzenText TextStyle="TextStyle.Caption">@customer.AccountNumber</RadzenText>
				@if (customer != null)
				{
					switch (customer.Type)
					{
						case CustomerType.VIP:
							<RadzenBadge Text="@customer.Type.ToString()" BadgeStyle="BadgeStyle.Primary" Shade="Shade.Lighter" class="no-uppercase" />
							break;
						case CustomerType.New:
							<RadzenBadge Text="@customer.Type.ToString()" BadgeStyle="BadgeStyle.Success" Shade="Shade.Lighter" class="no-uppercase" />
							break;
						case CustomerType.Prospect:
							<RadzenBadge Text="@customer.Type.ToString()" BadgeStyle="BadgeStyle.Light" Shade="Shade.Lighter" class="no-uppercase" />
							break;
						case CustomerType.Lead:
							<RadzenBadge Text="@customer.Type.ToString()" BadgeStyle="BadgeStyle.Warning" Shade="Shade.Lighter" class="no-uppercase" />
							break;
						case CustomerType.Existing:
							<RadzenBadge Text="@customer.Type.ToString()" BadgeStyle="BadgeStyle.Info" Shade="Shade.Lighter" class="no-uppercase" />
							break;
						default:
							<RadzenBadge Text="No Information" BadgeStyle="BadgeStyle.Secondary" Shade="Shade.Lighter" class="no-uppercase" />
							break;
					}
				}
				else
				{
					<RadzenBadge Text="No Information" BadgeStyle="BadgeStyle.Secondary" Shade="Shade.Lighter" class="no-uppercase" />
				}
			</RadzenStack>

		</RadzenStack>
	</Template>
</RadzenListBox>





@code {
	[Parameter] public List<Customer> Customers { get; set; }
	[Parameter] public Customer? SelectedCustomer { get; set; }
	[Parameter] public EventCallback<Customer> OnCustomerSelected { get; set; }

}
