
<RadzenTabs TabPosition="TabPosition.Left" Style="height: 600px;" @bind-SelectedIndex="selectedContactIndex">
	<Tabs>
		@foreach (var contact in contacts)
		{
			<RadzenTabsItem>
				<Template>
					<!-- Contact List Item -->
					<div class="contact-item">
						<RadzenAvatar Class="mr-2" Style="width: 40px; height: 40px;" Text="@contact.Name" />
						<div class="contact-info">
							<div class="d-flex justify-content-between">
								<strong>@contact.Name</strong>
								<small class="text-muted">@contact.LastMessageTime.ToString("hh:mm tt")</small>
							</div>
							<div class="text-truncate" style="max-width: 200px;">
								@contact.LastMessage
							</div>
						</div>
					</div>
				</Template>

				<ChildContent>
					<!-- Chat Area -->
					<div class="d-flex flex-column" style="height: 100%;">
						<!-- Message History -->
						<div class="flex-grow-1 overflow-auto mb-3">
							@foreach (var message in contact.Messages)
							{
								<div class="@("message-bubble " + (message.IsSender ? "sender" : "receiver"))">
									<div class="message-text">@message.Text</div>
									<div class="message-time">@message.Timestamp.ToString("hh:mm tt")</div>
								</div>
							}
						</div>

						<!-- Message Input -->
						<div class="d-flex align-items-center">
							<RadzenTextBox @bind-Value="newMessage" Placeholder="Type a message..." Style="flex-grow: 1;" />
							<RadzenButton Icon="send" Click="@(() => SendMessage(contact))" Class="ml-2" />
						</div>
					</div>
				</ChildContent>
			</RadzenTabsItem>
		}
	</Tabs>
</RadzenTabs>

@code {
	int selectedContactIndex = 0;
	string newMessage = string.Empty;

	private class Contact
	{
		public string Name { get; set; }
		public string LastMessage { get; set; }
		public DateTime LastMessageTime { get; set; }
		public List<Message> Messages { get; set; } = new();
	}

	private class Message
	{
		public string Text { get; set; }
		public DateTime Timestamp { get; set; }
		public bool IsSender { get; set; }
	}

	List<Contact> contacts = new List<Contact>()
	{
        // Sample contacts
        new Contact {
			Name = "John Doe",
			LastMessage = "See you tomorrow!",
			LastMessageTime = DateTime.Now.AddMinutes(-15),
			Messages = new List<Message>()
			{
				new Message { Text = "Hi there!", Timestamp = DateTime.Now.AddHours(-1), IsSender = false },
				new Message { Text = "Hello! How are you?", Timestamp = DateTime.Now.AddMinutes(-50), IsSender = true }
			}
		},
        // Add more contacts...
    };

	void SendMessage(Contact contact)
	{
		if (!string.IsNullOrWhiteSpace(newMessage))
		{
			contact.Messages.Add(new Message
				{
					Text = newMessage,
					Timestamp = DateTime.Now,
					IsSender = true
				});
			newMessage = string.Empty;
			contact.LastMessage = newMessage;
			contact.LastMessageTime = DateTime.Now;
		}
	}
}

<style>
	/* Contact list styling */
	.contact-item {
		padding: 10px;
		display: flex;
		align-items: center;
		width: 100%;
	}

	.contact-info {
		flex-grow: 1;
		min-width: 0;
	}

	/* Message bubbles */
	.message-bubble {
		max-width: 70%;
		padding: 8px 12px;
		border-radius: 15px;
		margin: 5px 0;
		position: relative;
	}

	.receiver {
		background: #f1f0f0;
		align-self: flex-start;
	}

	.sender {
		background: #007bff;
		color: white;
		align-self: flex-end;
	}

	.message-time {
		font-size: 0.75rem;
		opacity: 0.8;
		text-align: right;
	}
</style>
