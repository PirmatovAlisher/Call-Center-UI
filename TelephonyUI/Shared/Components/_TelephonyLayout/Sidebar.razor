
<RadzenSidebar Responsive="false" Style="width: max-content">
	<RadzenPanelMenu DisplayStyle="@(IsExpanded ? MenuItemDisplayStyle.IconAndText : MenuItemDisplayStyle.Icon)" ShowArrow="false">

		<RadzenPanelMenuItem Text="Overview" Icon="home" Path="/"/>
		<RadzenPanelMenuItem Text="Call History" Icon="call_log" Path="call-history" />
		<RadzenPanelMenuItem Text="Dashboard" Icon="dashboard" Path="counter"/>
		<RadzenPanelMenuItem Text="UI Fundamentals" Icon="auto_awesome">
			<RadzenPanelMenuItem Text="Themes" Icon="color_lens" Path="weather" />
			<RadzenPanelMenuItem Text="Colors" Icon="invert_colors" />
		</RadzenPanelMenuItem>

	</RadzenPanelMenu>
</RadzenSidebar>

@code {
	[Parameter]
	public bool IsExpanded { get; set; } = true;

	[Parameter]
	public EventCallback<bool> IsExpandedChanged { get; set; }
}