@using TelephonyUI.Shared.Components._TelephonyLayout
@inherits LayoutComponentBase
@implements IDisposable
@inject CallService CallService

<HeadContent>
	<RadzenTheme Theme="material" />
</HeadContent>
<RadzenComponents />

<RadzenLayout>
	<Header ToggleMenu="@ToggleSidebar" />

	<Sidebar @bind-IsExpanded="@sidebarExpanded" />

	<RadzenBody Style="padding: 0px !important;">

		@if (CallService.IsCallActive)
		{
			<CallingWindowTop />
		}

		<div class="rz-p-4">
			@Body
		</div>



	</RadzenBody>

	<Footer />
</RadzenLayout>

@code {
	private bool sidebarExpanded = true;

	protected override void OnInitialized()
	{
		CallService.OnCallStateChanged += StateHasChanged;
	}

	public void Dispose()
	{
		CallService.OnCallStateChanged -= StateHasChanged;
	}

	private void ToggleSidebar()
	{
		sidebarExpanded = !sidebarExpanded;
		StateHasChanged();
	}
}